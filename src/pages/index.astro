---
import Layout from '../layouts/Layout.astro';
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import pisoIlustration from '../assets/ilustrations/pisoIlus.png'
import techosIlustration from '../assets/ilustrations/techosIlus.png'
import { Image } from 'astro:assets';
---
<Layout>
   <section>
      <div class="grid">
        <a href="/maquinas" class="item item-spam">
          <div class="item-img">
            <Image src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
          </div>
          <div class="item-data">
            <h3>Calcula la capacidad de carga de tus maquinarias</h3>
            <p>Obtén una estimación precisa del volumen de material que transportas por cada carga de tu retroexcavadora, bobcat u otra maquinaria pesada.</p>
          </div>
        </a>

        <a href="/" class="item">
          <p>Para construir piso</p>
          <div class="item-data">
            <p>Calcula tus materiales para el piso</p>
            <Image src={pisoIlustration} width={pisoIlustration.width} height={pisoIlustration.height} alt="Ilustracion de la sección de pisos" />
          </div>
        </a>
        <a href="/" class="item">
          <p>Calcula el volumen de tus baldes</p>
          <div class="item-data"></div>
        </a>
        <a href="/" class="item item-spam">
          <p>Calcula el volumen de tus baldes</p>

        </a>
        
      </div>
   </section>
</Layout>

<style>
  section {
    width: 60%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem  ;
    color: #fff;
    
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;

      & a {
        text-decoration: none;
        color: #fff;
        overflow: hidden;
      }

      :hover{
        background-color: var(--color-secundario);
        transition: background-color 0.3s ease-in-out;
      }
    }

    .item {
      background-color: var(--color-primario);
      display: flex;
      flex-direction: column;
      padding: 1rem;
      border-radius: 15px;
      box-shadow: 1px 1px 3px 1px #fff3;

      & > p {
        width: 100%;
        padding-bottom: 0.4rem;
        font-weight: bolder;
        font-size: 1.3rem;
        font-style: italic;
        border-bottom: #fff3 1px solid;
        text-wrap: balance;
      }
    }

    .item-img{
      width: 100%;
      height: 400px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .item-data {
      
      & > h3 {
        margin: 0;
        padding: 0.2rem;
        font-size: 1.3rem;
        border-bottom: #fff3 1px solid;
      }

      & > p {
        margin: 0;
        padding:0.2rem;
        text-wrap: balance;
        opacity: 0.7;
        font-size: 1.1rem;
        width: 100%;
      }
    }

    .item-spam{
      grid-column: span 2;
    }

    @media (width < 768px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
</style>