---
import Layout from '../layouts/Layout.astro';
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import pisoIlustration from '../assets/ilustrations/pisoIlus.png'
import techosIlustration from '../assets/ilustrations/techosIlus.png'
import paredesIlustration from '../assets/ilustrations/paredesIlus.png'
import { Image } from 'astro:assets';
---
<Layout>
   <section>
      <div class="grid">
        <a href="/maquinas" class="item item-spam">
          <div class="item-img">
            <Image src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
          </div>
          <div class="item-data">
            <h3>Calcula la carga de tus maquinarias</h3>      
            <p>Determina el volumen de material pétreo que manejas por cada ciclo de carga con retroexcavadoras, minicargadores y similares.</p>
          </div>
        </a>

        <a href="/pisos" class="item">
          <div class="item-img">
            <Image src={pisoIlustration} width={pisoIlustration.width} height={pisoIlustration.height} alt="Ilustracion de la sección de pisos" />
          </div>
          <div class="item-data">
            <h3>Revestimiento de pisos</h3>
            <p>Obtén un estimado del material necesario para instalar pisos decorativos.</p>
          </div>
        </a>

        <a href="/paredes" class="item">
          <div class="item-img">
            <Image src={paredesIlustration} width={paredesIlustration.width} height={paredesIlustration.height} alt="Ilustracion de balde de minicargador" />
          </div>
          <div class="item-data">
            <h3>Construcción rápida con sistema Convitec</h3>      
            <p>Cálculo detallado de materiales para levantar paredes modulares en espacios de cualquier tamaño: desde baños hasta viviendas completas.</p>          </div>
        </a>

        <a href="/paredes" class="item item-spam">
          <div class="item-img">
            <Image src={techosIlustration} width={techosIlustration.width} height={techosIlustration.height} alt="Ilustracion de balde de minicargador" />
          </div>
          <div class="item-data">
            <h3>Planifica tu cielo raso fácilmente</h3>
            <p>Calcula cuántos paneles, mallas y perfiles metálicos necesitas para construir paredes con el sistema Convitec según las dimensiones de tu proyecto.</p>
          </div>
        </a>
        
      </div>
   </section>
</Layout>

<style>
  section {
    width: 70%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem  ;
    color: #fff;
     
    .grid {
      display: grid;
      padding-bottom: 3rem;
      width: 100%;
      grid-template-columns: 1fr 1fr ;
      gap: 2rem;

      & a {
        text-decoration: none;
        color: #fff;
        overflow: hidden;
      }

      :hover{
        background-color: var(--color-secundario);
        transition: background-color 0.3s ease-in-out;
      }
    }

    .item {
      background-color: var(--color-primario);
      display: flex;
       
      flex-direction: column;
      padding: 1rem;
      border-radius: 15px;
      box-shadow: 1px 1px 3px 1px #fff3;

      & > p {
        width: 100%;
        padding-bottom: 0.4rem;
        font-weight: bolder;
        font-size: 1.3rem;
        font-style: italic;
        border-bottom: #fff3 1px solid;
        text-wrap: balance;
      }
    }

    .item-img{
      width: 100%;
      height: 350px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    .item-data {
      
      & > h3 {
        margin: 0;
        padding: 0.2rem;
        font-size: 1.3rem;
        border-bottom: #fff3 1px solid;
        font-style: italic;
      }

      & > p {
        margin: 0;
        padding:0.2rem;
        text-wrap: pretty;
        opacity: 0.7;
        font-size: 1.1rem;
         
      }
    }

    .item-spam{
      grid-column: span 1;
    }

    @media (width < 768px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
</style>