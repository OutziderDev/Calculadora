---
import Layout from '../layouts/Layout.astro';
import bucketIlustration from '../assets/ilustrations/bucketCalculator.png'
import pisoIlustration from '../assets/ilustrations/pisoCalculador.png'
import { Image } from 'astro:assets';
---
<Layout>
   <section>
      <div class="grid">
        <div class="item">
          <p>para construir</p>
          <Image src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
        </div>
        <div class="item">
          <p>Para construir piso</p>
          <Image src={pisoIlustration} width={pisoIlustration.width} height={pisoIlustration.height} alt="Ilustracion de la sección de pisos" />
        </div>
        <div class="item">caca</div>
        <div class="item">saca</div>
        <div class="item">casa</div>
      </div>
   </section>
</Layout>

<style>
  section{
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem  ;
    color: #fff;
    
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .item {
      background-color: var(--color-primario);
      overflow:hidden;
      display: flex;
      padding: 1.5rem;
      border-radius: 15px;
      box-shadow: 1px 1px 3px 1px #fff3;

      & p {
        
      }

      & img {
        width: 80%;
        user-select: none;
        height: 80%;
        object-fit: contain;
      }
    }

    @media (width < 768px) {
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
        
      }
    }
  }
</style>