---
import Layout from '../layouts/Layout.astro';
import bucketIlustration from '../assets/ilustrations/bucketCalculator.png'
import pisoIlustration from '../assets/ilustrations/pisoCalculador.png'
import { Image } from 'astro:assets';
---
<Layout>
   <section>
      <div class="grid">
        <a href="/maquinas" class="item">
          <p>Consulta la capacidad de tus maquinarias pesadas</p>
          <div class="item-data">
            <p>Saca tus calculos para que sepas exactamente cuanta materia petrea estas distribuyendo con cada pala de tus maquinarias</p>
            <Image src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
          </div>
        </a>
        <a href="/" class="item">
          <p>Para construir piso</p>
          <div class="item-data">
            <p>Calcula tus materiales para el piso</p>
            <Image src={pisoIlustration} width={pisoIlustration.width} height={pisoIlustration.height} alt="Ilustracion de la sección de pisos" />
          </div>
        </a>
        <a href="/" class="item">
          <p>Calcula el volumen de tus baldes</p>
          <div class="item-data"></div>
        </a>
        <a href="/" class="item">
          <p>Calcula el volumen de tus baldes</p>

        </a>
        
      </div>
   </section>
</Layout>

<style>
  section{
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem  ;
    color: #fff;
    
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;

      & a {
        text-decoration: none;
        color: #fff;
        overflow: hidden;
      }

      :hover{
        background-color: var(--color-secundario);
        transition: background-color 0.3s ease-in-out;
      }
    }

    .item {
      background-color: var(--color-primario);
      display: flex;
      flex-direction: column;
      padding: 1rem;
      border-radius: 15px;
      box-shadow: 1px 1px 3px 1px #fff3;

      & > p {
        width: 100%;
        padding-bottom: 0.4rem;
        font-weight: bolder;
        font-size: 1.3rem;
        font-style: italic;
        border-bottom: #fff3 1px solid;
        text-wrap: balance;
      }
    }

    .item-data {
      display: flex;
      flex-direction: row;
      justify-items: center;

      & > p {
        margin: 0;
        text-wrap: balance;
        opacity: 0.8;
        font-size: 1.1rem;
      }

      & img {
        margin: 0;
        padding: 0;
        width: 70%;
        height: 70%;
        object-fit: cover;
      }
    }

    @media (width < 768px) {
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
</style>