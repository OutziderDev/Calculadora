---
import Layout from "../layouts/Layout.astro";
import Image from 'astro/components/Image.astro'
import pisosIlustration from '../assets/ilustrations/pisoIlus.webp'
---
<Layout title="Calculador de Materiales para Pisos">
  <section>
    <h1>Calcula los elementos necesarios para tu revestimiento de pisos</h1>

    <div class="grid">
      <div class="item bg-color">
        <h3 class="item-title">Calcular Revestimiento</h3>
        <div class="item-data">
          <p class="span-2">Dimensiones del Area:</p>
          <div class="data-form-box">
            <label for="ancho">Ancho</label>
            <input type="number" min="0" max="50" maxlength="3" placeholder="3.20 mts" class="input" name="ancho" id="ancho">
          </div>
          <div class="data-form-box">
            <label for="largo">Largo</label>
            <input type="number" min="0" max="50" maxlength="3" placeholder="3.20 mts" class="input" name="largo" id="largo">
          </div>
           
          <select name="tipoBaldosas" class="input" id="tipoBaldosas">
            <option value="0.20">20 ctm x 20 ctm</option>
            <option value="0.30">30 ctm x 30 ctm</option>
            <option value="0.45" selected>45 ctm x 45 ctm</option>
            <option value="0.60">60 ctm x 60 ctm</option>
          </select>
          <button id="btncalcmaterial" > Calcular</button>
        </div>
        <div class="item-result">
          <p>Área según dimensiones:</p>
          <div>
            <span id="resultadoArea">0</span> <p>M<sup>2</sup></p>
          </div>
          <p>Cantidad requerida:</p>
          <div>
            <span id="resultadoRevestimiento">0</span> <p>Unidades</p>
          </div>
          <span class="leyenda">incluye un 10% adicional por errores</span>
        </div>
      </div>

      <div class="item bg-color">
        <h3 class="item-title">Cálculo de precio</h3>
        <div class="item-data">
          <p class="span-2">Datos Generales:</p>
          <div class="data-form-box">
            <label for="area">Área de revestimiento</label>
            <input class="input" type="number" id="area" placeholder="15.36 m" min="0" max="100" maxlength="3">
          </div>
          <div class="data-form-box">
            <label for="precio">Precio por M²</label>
            <input type="number" id="precio" class="input" placeholder="4.99 $">
          </div>
          <div class="data-form-box">
            <label for="mtxcaja">Metros² por caja</label>
            <input type="number" id="mtxcaja" class="input" placeholder="2.04 m2">
          </div>
          <button id="btnCalcularPrecio">Calcular</button>
        </div>
        <div class="item-result">
          <p>Precio unitario por caja</p>
          <div>
            <span id="resultPrecio">0</span> <p>Usd.</p> 
          </div>
          <p>Precio total de material y precio</p>
          <div>
            <span id="resultMaterialTotal">0</span> <p>Cajas con valor de: </p><br>
            <span id="precioTotal">0</span><p>Usd.</p>
          </div>
        </div>
      </div>
      
      <div class="item">
        <Image transition:name="iluspisos" priority src={pisosIlustration} width={pisosIlustration.width} height={pisosIlustration.height} alt="Ilustración de la seccion de Pisos" />
      </div>
      
    </div>
  </section>
</Layout>

<style>
  section{
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;
  }
  
  h1{
    margin: 0;
    text-align: center;
    font-style: italic;
    padding-block: 2rem;
    width: 100%;
    font-weight: bold;
  }

  .grid{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    
  }

  .item {
    padding: 0.5rem;
    border-radius: 5px;
    width: auto;
    max-height: 500px;
    display: flex;
    flex-direction: column;

    & > img{
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
  }

  .item-title{
    margin: 0;
    text-align: center;
    text-wrap: balance;
    margin-block: 0.5rem;
    height: 5%;
  }

  .item-data{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
    padding-block: 1rem;
    height: 40%;

    & > p {
      margin: 0;
      padding: 0;
      font-weight: bold;
    }

    & > button {
      border-radius: 5px;
      border: none;
      cursor: pointer;
      font-weight: bold;
      background-color: var(--color-terciario-maquina);
    }
    & > button:hover{
      filter: contrast(120%)
    }
    & > button:active{
      filter: contrast(150%)
    }
  }

  .item-result{
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 50%;

    & > div {
      text-align: center;
      
      & > span {
        font-family: monospace;
        font-size: 2rem;
        color: var(--color-terciario-maquina);
      }

      & > p{
        font-weight: bold;
        font-size: 1.2rem;
        display: inline;
      }
    }

    & > p {
      margin: 0;
      padding: 0;
      font-weight: bold;
    }

    .leyenda {
      color: #fff5;
      text-align: center;
    }
    
  }

  .bg-color {
    background-color: var(--color-secundario);
  }

  .data-form-box{
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  } 

  .input {
    border-radius: 5px;
    border: none;
    padding: 0.3rem;
    outline: none;
    box-shadow: 1px 1px 1px 2px #ccc;

  }
  .input:focus {
    box-shadow: 1px 1px 1px 2px var(--color-terciario-maquina);
  }

  .span-2{
    grid-column: span 2;
  }

  @media (width < 1024px) {
    section {
      width: 100%;
    }

    h1{
      font-size: 1.1rem;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }  
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const anchoPiso = document.getElementById('ancho') as HTMLInputElement
    const largoPiso = document.getElementById('largo') as HTMLInputElement
    const tipoRevestimiento = document.getElementById('tipoBaldosas') as HTMLSelectElement
    const resultArea = document.getElementById('resultadoArea') as HTMLElement
    const resultRevestimiento = document.getElementById('resultadoRevestimiento') as HTMLElement
    const btnCalcular = document.getElementById('btncalcmaterial')
        
    btnCalcular?.addEventListener('click',() => {
      if ( isNaN(parseFloat(anchoPiso.value)) || isNaN(parseFloat(largoPiso.value)) ) {
        alert('Introduzca las dimensiones')
        return
      }
      const calcArea = parseFloat(anchoPiso.value) * parseFloat(largoPiso.value)
      const areaDeMaterial : number = parseFloat(tipoRevestimiento.value) * parseFloat(tipoRevestimiento.value)

      const calcCantRevestimiento = (calcArea / areaDeMaterial) * 1.1

      resultArea.innerText = calcArea.toFixed(2) 
      resultRevestimiento.innerText = calcCantRevestimiento.toFixed(0)
    })
  })
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const areaInput = document.getElementById('area') as HTMLInputElement
    const precioxMetro = document.getElementById('precio') as HTMLInputElement
    const mxcaja = document.getElementById('mtxcaja') as HTMLInputElement 
    const resPrecioUni = document.getElementById('resultPrecio') as HTMLElement
    const resMaterialTotal = document.getElementById('resultMaterialTotal') as HTMLElement
    const resPrecioTotal = document.getElementById('precioTotal') as HTMLElement
    const btnCalcPrecios = document.getElementById('btnCalcularPrecio') as HTMLElement

    btnCalcPrecios.addEventListener('click', () => {
      if ( isNaN(parseFloat(precioxMetro.value)) || isNaN(parseFloat(mxcaja.value)) ) {
        alert('Introduzca las datos')
        return
      }

      const calc = parseFloat(precioxMetro.value) * parseFloat(mxcaja.value) 
      resPrecioUni.innerText = calc.toFixed(2)

      const areaConMargen = parseFloat(areaInput.value) * 1.1
      const material = Math.ceil(areaConMargen / parseFloat(mxcaja.value))
      resMaterialTotal.innerText = material.toFixed(0)

      const precioFinal = material * calc
      resPrecioTotal.innerHTML = precioFinal.toFixed(2)
    })
  })
</script>