---
import Layout from "../layouts/Layout.astro";
import ilusParedes from "../assets/ilustrations/paredesIlus.webp"
import { Image } from "astro:assets";
---
<Layout title="Calculador de Materiales para Paredes">
  <section>
    <h1>¡Calculos relacionados con tus sistemas convitec!</h1>
    <div class="grid">
   
      <div class="item">
        <Image priority transition:name="iluspared" src={ilusParedes} alt={"Ilustración de la sección de sistemas constructivos"}  />
      </div>

      <div class="item bg-color">
        <h1 class="item-title">Conversiones de Unidades Convitec</h1>
        <div class="formu">
          <div class="input-group">
            <label for="lamina">Tipo de lámina:</label>
            <select class="input" id="lamina">
              <option value="4x8">PE-100 de 4'x 8' / 3.94</option>
              <option value="4x10">PE-50 de 4'x 10' / 1.97</option>
              <!-- <option value="4x8s">PE-50 de 4'x 8' / 1.97</option> -->
            </select>
          </div>
          <div class="input-group">
            <label for="cantLam">Cantidad en M2</label>
            <input type="number" id="cantLam" class="input" placeholder="29.70 M2">
          </div>
        </div>
        <div class="lamResult">
          <p>Cantidad fisica de láminas:</p>
          <span id="resultLam">0</span>
          <p>Cantidad de Cemento:</p>
          <span id="resultCemento">0</span>
        </div>
      </div>

      <div class="item bg-color">casa</div>

    </div>
  </section>
</Layout>

<style>
  section{
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;

    h1{
      margin: 0;
      padding: 2rem;
      text-align: center;
      font-style: italic;
      font-size: 2rem;
    }
    
    .grid{
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      /* grid-template-rows: 1fr 1fr; */
      gap: 1rem;
      width: 100%;
      margin-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .item {
      padding: 0.5rem;
      border-radius: 5px;
      max-height: 500px;
      display: flex;
      flex-direction: column;

      & > img{
        object-fit: cover;
        width: 100%;
        height: 100%;
      }
    }

    .item-title{
      margin: 0;
      text-align: center;
      text-wrap: balance;
      padding-block: 1rem;
      height: 5%;
    }
    
    .formu {
      margin-top: 1rem;
      padding-block: 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      border-bottom: 1px solid #fff3;

      .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.3rem
      }
    }

    .lamResult {
      display: flex;
      flex-direction: column;

      p {
        margin-block: 0.5rem;
        font-weight: bolder;
      }
      span {
        color: var(--color-terciario-maquina);
        font-size: 3rem;
        font-family: monospace;
        text-align: center;
      }
    }

    .input {
      border-radius: 5px;
      border: none;
      padding: 0.3rem;
      outline: none;
      box-shadow: 1px 1px 1px 2px #ccc;
    }
    .input:focus {
      box-shadow: 1px 1px 1px 2px var(--color-terciario-maquina);
    }

    .span-2 {
      grid-column: span 2;
    }

    .bg-color {
      background-color: var(--color-secundario);
    }

    @media ( width < 1024px){
      section {
        width: 100%;
      }

      h1{
        font-size: 1.6rem;
        text-wrap: balance;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .formu {
        grid-template-columns: 1fr;
      }
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tipoLaminas = document.getElementById('lamina') as HTMLSelectElement
    const cantLaminas = document.getElementById('cantLam') as HTMLInputElement
    const resultado = document.getElementById('resultLam') as HTMLElement
    const resultCemento = document.getElementById('resultCemento') as HTMLElement
    
    cantLaminas?.addEventListener('change', () => {
      let calc;
      const volumen = parseFloat(cantLaminas.value) * 0.015

      if( tipoLaminas.value === '4x8'){
        calc = parseFloat(cantLaminas.value) / 2.9768
      }
      if ( tipoLaminas.value === '4x10'){
        calc = parseFloat(cantLaminas.value) / 3.721
      }

      resultado.innerText = ''+ calc?.toFixed(0)

      const sacosxM3 = 7.5
      const sacos = Math.ceil(volumen * sacosxM3)
      resultCemento.innerText = '' + sacos
    })

  })
</script>