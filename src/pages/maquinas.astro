---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import ChangeIcon from '../assets/icons/transfer.svg'
---
<Layout title="Capacidad de Carga de Retroexcavadora ">
  <section>
    <h1>¡Calcula todo sobre tus maquinarias!</h1>
    <div class="grid">
      <div class="item bg-color">
        <h3 class="item-title">Conversiones de Longitud</h3>
        <div class="item-data">
          
          <div class="conversiones">
            <div class="yarda-metro">
              <span>Yardas</span>
              <input type="text" name="" placeholder="1 yarda" id="">
            </div>
            <button>
              <ChangeIcon stroke="white"/>
            </button>
            <div class="yarda-metro">
              <span>Metros</span>
              <input type="text" name="" placeholder="1 yarda" id="">
            </div>
          </div>
          <div class="result">
            <p id="resultado">0.76<span id="metrica"> mts</span></p>
          </div>
          

        </div>
      </div>
      
      <div class="item img-item">
        <Image transition:name="pala" transition:persist src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
      </div>

      <div class="item bg-color">
        lala
      </div>
    </div>

  </section>
</Layout>

<style>
  section {
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;

    h1{
      margin: 0;
      /* margin-top: 0.7rem; */
      text-align: center;
      font-style: italic;
      font-size: 2rem;
    }
    
    .grid{
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      /* grid-template-rows: 1fr 1fr; */
      width: 100%;
      margin-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .item {
      width: 100%;
      height: 350px;
      border-radius: 10px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .item-title {
        margin: 0;
        text-align: center;
        font-style: italic;
        font-size: 1.3rem;
        padding: 0.5rem;
      }
      .item-data{
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0.5rem;

        .conversiones{
          display: flex;
          align-items: center;
          gap: 1rem;
          padding-bottom: 1.2rem;
          border-bottom: 1px solid var(--color-secundario);

          & > button{
            display: flex;
            align-items: center;
            justify-items: center;
            background: none;
            cursor: pointer;
            border: none;
            

            & > svg{
              padding: 0;
              width: 100%;
              border-radius: 3px;
              padding: 0.3rem;
              background: var(--color-base);
              border:1px solid var(--color-secundario ) ;
            }

            :hover {
              background-color: var(--color-secundario);
            }
          }

          .yarda-metro{
            display: flex;
            gap: 0.5rem;
            flex-direction: column;
            align-items: center;

            & input {
              width: 90%;
              background: #ececec;
              border: none;
              padding: 0.3rem;
              border-radius: 5px;
              text-align: end;
              outline:none;
               box-shadow:  1px 1px 1px 2px rgb(152, 152, 152);
            }
            & input:focus {
               box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
              }

            & span{
              font-weight: bold;
            }
          }

        }

        .result{
          width: 100%;
          height: 200px;
          display: flex;
          font-family: monospace ;
          justify-content: center;
          align-items: center;
          p{
            font-size: 4rem;
            margin: 0;
            padding: 0;

            & > span {
              font-size: 3rem;
            }
          }
        }

        @media (width < 768px)
        {
          .result {
            p{
              font-size: 2rem;
              & > span {
                font-size: 1rem;
              }
            }
          }
        }
      }
    }

    @media (width < 768px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
  .bg-color {
    background-color: var(--color-primario);
  }
</style>