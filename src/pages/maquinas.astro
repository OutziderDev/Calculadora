---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import ChangeIcon from '../assets/icons/transfer.svg'
---
<Layout title="Capacidad de Carga de Retroexcavadora ">
  <section>
    <h1>¡Calcula todo sobre tus maquinarias!</h1>
    <div class="grid">
      <div class="item bg-color">
        <h3 class="item-title">Conversor de Volumen de Materiales</h3>
        <div class="item-data">
          
          <div class="conversiones">
            
            <select id="opc1" name="" >
              <option value="yd3" selected>Yarda (yd³)</option>
              <option value="m3"> Metros (m³)</option>
              <option value="ft3">Pie cúbico (ft³)</option>
            </select>
            
            <button id="changeUnidad">
              <ChangeIcon stroke="white"/>
            </button>
             
            <select id="opc2" name="" >
              <option value="yd3" >Yarda (yd³)</option>
              <option value="m3" selected> Metros (m³)</option>
              <option value="ft3">Pie cúbico (ft³)</option>
            </select>
            
          </div>
          <div class="cantidad">
            <!-- <label for="cant">Cantidad:</label> -->
            <input type="number" min="0" max="100" placeholder=" Cantidad: 6"   id="cant">
          </div>
          <div class="result">
            <p id="resultado">0</p>
            <span id="metrica"> mt</span><sup id="exponente">3</sup>
          </div>
          
        </div>
      </div>
      
      <div class="item img-item">
        <Image priority transition:name="pala" transition:persist src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
      </div>

      <div class="item bg-color row-span">
        <h3 class="item-title">Tabla de Conversiones Basica</h3>
        <div class="item-data">
          
        </div>
      </div>

      <div class="item bg-color">
        <h3 class="item-title">Cacular Capacidad de balde</h3>
        <div class="item-data">
          <div class="formulario">
            <div class="contenWithLabel">
              <label for="baldeAncho">Ancho:</label>  
              <input type="number" id="baldeAncho" placeholder="49 inc" min="0" max="50" maxlength="4">
            </div>

            <div class="contenWithLabel">
              <label for="baldeAlto">Altura:</label>
              <input type="number" id="baldeAlto" placeholder="49 inc" min="0" max="50" maxlength="4">
            </div>

            <div class="contenWithLabel">
              <label for="baldeProfundidad">Profundidad:</label>
              <input type="number" id="baldeProfundidad" placeholder="49 inc" min="0" max="50" maxlength="4">
            </div>

            <div class="contenWithLabel">
              <label for="baldemetrica">Resultado:</label>
              <select id="baldemetrica">
                <option value="yd3" selected>Yarda (yd³)</option>
                <option value="m3"> Metros (m³)</option>
              </select>
            </div>
            <button id="calcBalde">Calcular</button>
          </div>
          <div class="formResult">
            <p class="balderesultado ">0</p>
          </div>
        </div>
      </div>
    </div>

  </section>
</Layout>

<style>
  section {
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;

    h1{
      margin: 0;
      /* margin-top: 0.7rem; */
      text-align: center;
      font-style: italic;
      font-size: 2rem;
    }
    
    .grid{
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 2rem;
      width: 100%;
      margin-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .item {
      width: 100%;
      
      border-radius: 10px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .item-title {
        margin: 0;
        text-align: center;
        font-style: italic;
        font-size: 1.1rem;
        padding: 0.5rem;
      }
      .item-data{
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1rem;

        .conversiones{
          display: flex;
          width: 100%;
          align-items: center;
          justify-content: center;
          gap: 1rem;

          & > button{
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-items: center;
            background: none;
            cursor: pointer;
            border: none;

            & > svg{
              padding: 0;
              width: 100%;
              border-radius: 3px;
              padding: 0.3rem;
              background: var(--color-base);
              border:1px solid var(--color-secundario ) ;
            }

            :hover {
              background-color: var(--color-secundario);
            }
          }

          & select {
            width: 100%;
            background: #ececec;
            border: none;
            padding: 0.3rem;
            border-radius: 5px;
            text-align: end;
            outline:none;
            box-shadow:  1px 1px 1px 2px rgb(152, 152, 152);
          }

          & select:focus {
            box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
          }

        }
        
        .cantidad{
          width: 100%;
          display: flex;
          margin-top: 1rem;
          padding-bottom: 1rem;
          border-bottom: 2px solid var(--color-secundario);

          & input {
            width: 100%;
            background: #ececec;
            border: none;
            padding: 0.3rem;
            border-radius: 5px;
            text-align: end;
            outline:none;
            box-shadow:  1px 1px 1px 2px rgb(152, 152, 152);
          }

          & input:focus {
              box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
          }
        }
        
        .result{
          width: 100%;
          margin-top: 5%;
          display: flex;
          text-wrap: pretty;
          gap: 1rem;
          font-family: monospace ;
          justify-content: center;
          align-items: center;

          p{
            font-size: 4rem;
            margin: 0;
            padding: 0;
            word-break: break-all;
            overflow-wrap: break-word;
            /* max-width: 100%; */
          }
          span {
            margin: 0;
            font-size: 3rem;
            text-transform: uppercase;
          }
          sup{
            margin-left: -15px;
            margin-top: -15px;
            padding: 0;
            font-size: 1.5rem;
          }
        }

        .formulario {
          width: 100%;
          height: 50%;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 0.5rem;
          padding-bottom: 1rem;
          border-bottom: 2px solid var(--color-secundario);
          
          .contenWithLabel {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;

            & > label {
              opacity: 60%;
            }

            & > input, select {
              border-radius: 5px;
              padding: 5px;
              text-align: end;
              box-shadow:  0px 1px 1px 0.5px rgb(189, 188, 184);
              border: none;
              outline: none;
            }
            
            & > input:focus {
              box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
            }
          }

          & > button {
            grid-column: span 2;
            font-size: 1rem;
            border-radius: 5px;
            padding: 5px;
            background-color: rgb(255, 221, 0);
            cursor: pointer;
            box-shadow: 2px 2px 1px 0px rgb(125, 125, 125);
          }

          & >  button:active{
            background-color: rgb(224, 194, 2);
            box-shadow: 1px 1px 1px 0px rgb(125, 125, 125);
          }
        }

        .formResult {
          width: 100%;
          height: 50%;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;

          & > p {
            font-size: 3rem;
            font-family: monospace;
          }
        }

        @media (width < 1024px)
        {
          .result {
            p{
              font-size: 3rem;
            }

            span {
              font-size: 2rem;
            }

            sup {
              font-size: 1rem;
            }
          }
        }
      }
    }

    @media (width < 1024px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
  .bg-color {
    background-color: var(--color-primario);
  }

  .row-span {
    grid-row: span 2;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const select1  = document.getElementById('opc1')! as HTMLSelectElement 
    const select2 = document.getElementById('opc2')! as HTMLSelectElement
    const btnchange = document.getElementById('changeUnidad')
    const inputCant = document.getElementById('cant') as HTMLInputElement
    const textResultado = document.getElementById('resultado')
    const textMetrica = document.getElementById('metrica') 
    const textExponente = document.getElementById('exponente')

    btnchange?.addEventListener('click', () => {
      const temp = select1.value
      select1.value = select2.value
      select2.value = temp
      inputCant.value = ''
      if (textResultado) textResultado.innerHTML = '0';
      if (textMetrica) textMetrica.innerHTML = select2.value.slice(0,-1)
      /* if (textExponente) textExponente.innerHTML = '3' */
    })
    
    let prev1 = select1.value;
    let prev2 = select2.value;

    select1.addEventListener('focus', () => {
      prev1 = select1.value;
    });

    select2.addEventListener('focus', () => {
      prev2 = select2.value;
    });

    select1.addEventListener('change', () => {
      if (select1.value === select2.value) {
        select2.value = prev1;
      }
    });

    select2.addEventListener('change', () => {
      if (select2.value === select1.value) {
        select1.value = prev2;
      }
    });
    

    /* Calculos de Conversiones */
    const calcular = () => {
      const val = parseFloat(inputCant.value) || 0;
      let resultado = 0;

      switch (select1.value+"_a_"+select2.value) {
        case "yd3_a_m3":
          resultado = val * 0.7646
          break

        case "yd3_a_ft3":
          resultado = val * 27
          break
          
        case "m3_a_yd3":
          resultado = val * 1.31
          break

        case "m3_a_ft3":
          resultado = val * 35.3147
          break

        case "ft3_a_yd3":
          resultado = val / 27
          break

        case "ft3_a_m3":
          resultado = val * 0.0283168
          break

        default: 
          resultado = val
          
      }

      if (textResultado) textResultado.innerHTML = resultado.toFixed(2)
      if (textMetrica) textMetrica.innerHTML = select2.value.slice(0,-1)
    }

    inputCant.addEventListener('change', () => {
       calcular()
    })

  })  
</script>