---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import ChangeIcon from '../assets/icons/transfer.svg'
---
<Layout title="Capacidad de Carga de Retroexcavadora ">
  <section>
    <h1>¡Calcula todo sobre tus maquinarias!</h1>
    <div class="grid">
      <div class="item bg-color">
        <h3 class="item-title">Conversor de Volumen de Materiales</h3>
        <div class="item-data">
          
          <div class="conversiones">
            
            <select id="opc1" name="" >
              <option value="yd3" selected>Yarda (yd³)</option>
              <option value="m3"> Metros (m³)</option>
              <option value="ft3">Pie cúbico (ft³)</option>
            </select>
            
            <button id="changeUnidad">
              <ChangeIcon stroke="white"/>
            </button>
             
            <select id="opc2" name="" >
              <option value="yd3" >Yarda (yd³)</option>
              <option value="m3" selected> Metros (m³)</option>
              <option value="ft3">Pie cúbico (ft³)</option>
            </select>
            
          </div>
          <div class="cantidad">
            <!-- <label for="cant">Cantidad:</label> -->
            <input type="number" min="0" placeholder=" Cantidad: 6" id="cant">
          </div>
          <div class="result">
            <p id="resultado">0</p>
            <span id="metrica"> mt<sup>3</sup></span>
          </div>
          
        </div>
      </div>
      
      <div class="item img-item">
        <Image priority transition:name="pala" transition:persist src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
      </div>

      <div class="item bg-color">
        lala
      </div>
    </div>

  </section>
</Layout>

<style>
  section {
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;

    h1{
      margin: 0;
      /* margin-top: 0.7rem; */
      text-align: center;
      font-style: italic;
      font-size: 2rem;
    }
    
    .grid{
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      /* grid-template-rows: 1fr 1fr; */
      width: 100%;
      margin-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .item {
      width: 100%;
      height: 350px;
      border-radius: 10px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .item-title {
        margin: 0;
        text-align: center;
        font-style: italic;
        font-size: 1.1rem;
        padding: 0.5rem;
      }
      .item-data{
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1rem;

        .conversiones{
          display: flex;
          width: 100%;
          align-items: center;
          justify-content: center;
          gap: 1rem;

          & > button{
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-items: center;
            background: none;
            cursor: pointer;
            border: none;

            & > svg{
              padding: 0;
              width: 100%;
              border-radius: 3px;
              padding: 0.3rem;
              background: var(--color-base);
              border:1px solid var(--color-secundario ) ;
            }

            :hover {
              background-color: var(--color-secundario);
            }
          }

          & select {
            width: 100%;
            background: #ececec;
            border: none;
            padding: 0.3rem;
            border-radius: 5px;
            text-align: end;
            outline:none;
              box-shadow:  1px 1px 1px 2px rgb(152, 152, 152);
          }

          & select:focus {
              box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
          }

        }
        
        .cantidad{
          width: 100%;
          display: flex;
          margin-top: 1rem;
          padding-bottom: 1rem;
          border-bottom: 2px solid var(--color-secundario);

          & input {
            width: 100%;
            background: #ececec;
            border: none;
            padding: 0.3rem;
            border-radius: 5px;
            text-align: end;
            outline:none;
            box-shadow:  1px 1px 1px 2px rgb(152, 152, 152);
          }

          & input:focus {
              box-shadow:  1px 1px 1px 2px rgb(243, 196, 9);
          }
        }
        
        .result{
          width: 100%;
          height: 25%;
          margin-top: 5%;
          display: flex;
          gap: 1rem;
          font-family: monospace ;
          justify-content: center;
          align-items: center;

          p{
            font-size: 4rem;
            margin: 0;
            padding: 0;
          }
          span {
            font-size: 3rem;
            text-transform: uppercase;

            & > sup{
              font-size: 1.5rem;
            }
          }
        }

        @media (width < 768px)
        {
          .result {
            p{
              font-size: 2rem;
              & > span {
                font-size: 1rem;
              }
            }
          }
        }
      }
    }

    @media (width < 1024px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
  .bg-color {
    background-color: var(--color-primario);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const select1  = document.getElementById('opc1')! as HTMLSelectElement 
    const select2 = document.getElementById('opc2')! as HTMLSelectElement
    const btnchange = document.getElementById('changeUnidad')

    const selects = document.querySelectorAll("select") as NodeListOf<HTMLSelectElement>
    selects.forEach( (select : HTMLSelectElement) => {
      select.addEventListener('change', () => {
        if (select1.value === select2.value) {
          const temp = select1.value
          select1.value = select2.value
          select2.value = temp
          
        }
      })
    })

  })  
</script>
