---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import bucketIlustration from '../assets/ilustrations/bucketIlus.png'
import ChangeIcon from '../assets/icons/transfer.svg'
---
<Layout title="Capacidad de Carga de Retroexcavadora ">
  <section>
    <h1>¡Calcula todo sobre tus maquinarias!</h1>
    <div class="grid">
      <div class="item bg-color">
        <h3 class="item-title">Conversiones de Longitudes</h3>
        <div class="item-data">
          <div>
            <div class="yarda-metro">
              <span>Yardas</span>
            </div>
            <button>
              <ChangeIcon stroke="white"/>
            </button>
            <div class="yarda-metro">
              <span>Yardas</span>
            </div>
                  </div>
          </div>
      </div>
      
      <div class="item img-item">
        <Image transition:name="pala" transition:persist src={bucketIlustration} width={bucketIlustration.width} height={bucketIlustration.height} alt="Ilustracion de balde de minicargador" />
      </div>

      <div class="item bg-color">
        lala
      </div>
    </div>

  </section>
</Layout>

<style>
  section {
    width: 90%;
    height: 100%;
    margin-inline: auto;
    padding: 0.5rem;
    color: #fff;

    h1{
      margin: 0;
      /* margin-top: 0.7rem; */
      text-align: center;
      font-style: italic;
      font-size: 2rem;
    }
    
    .grid{
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2rem;
      /* grid-template-rows: 1fr 1fr; */
      width: 100%;
      margin-top: 0.6rem;
      padding-bottom: 3rem;
    }

    .item {
      width: 100%;
      height: 350px;
      border-radius: 10px;

      & > img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
      }

      .item-title {
        margin: 0;
        text-align: center;
        font-style: italic;
        font-size: 1.3rem;
        padding: 0.5rem;
      }
      .item-data{

        & > button{
          display: flex;
          
          align-items: center;
          justify-items: center;
          background: var(--color-base);
          cursor: pointer;
          border: none;
          border-radius: 5px;

          :hover {
            background-color: var(--color-secundario);
          }
        }
      }
    }

    @media (width < 768px) {
       width: 100%;
       
      .grid {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }
    }
  }
  .bg-color {
    background-color: var(--color-primario);
  }
</style>