<sidebar id="sidebarMenu" class="">
  <input type="checkbox" id="toggle-sidebar" hidden >

  <div class="title-sidebar">
    <h3>Menú</h3>
    <label for="toggle-sidebar" aria-label="toggle sidebar">
      <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 4l0 10" /><path d="M12 4l4 4" /><path d="M12 4l-4 4" /><path d="M4 20l16 0" /></svg>
    </label>
  </div>

  <ul class="sidebarOpcMenu">
    <li>
      <a href="/">
        <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l-2 0l9 -9l9 9l-2 0" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" /></svg>
        <p>Inicio</p>
      </a>
    </li>
    <li>
      <a href="/maquinas">
        <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M13 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M13 19l-9 0" /><path d="M4 15l9 0" /><path d="M8 12v-5h2a3 3 0 0 1 3 3v5" /><path d="M5 15v-2a1 1 0 0 1 1 -1h7" /><path d="M21.12 9.88l-3.12 -4.88l-5 5" /><path d="M21.12 9.88a3 3 0 0 1 -2.12 5.12a3 3 0 0 1 -2.12 -.88l4.24 -4.24z" /></svg>
        <p>Equipo Pesado</p>
      </a>
    </li>
    <li>
      <a href="/paredes">
        <svg xmlns="http://www.w3.org/2000/svg"  width="24"  height="24" viewBox="0 0 24 24">
          <path d="M12 1 1 1 1 23 23 23 23 19 23 15 23 11 19 11 19 15 1 15M19 15 23 15M23 19 1 19M19 19 19 23M15 15 15 19M9 15 9 19M5 19 5 23M12 19 12 23M12 15 12 11 5 11 5 15M5 11 1 11M9 11 9 6 1 6M5 6 5 1M12 1M12 1 12 6 9 6Z" stroke="#FFf" stroke-width="2" fill="none"/>
        </svg>
        <p>Paredes</p>
      </a>
    </li>
    <li>
      <a href="/techos">
        <svg xmlns="http://www.w3.org/2000/svg" width="24"  height="24" viewBox="-1 -1 28 24">
          <path d="M 0 7 L 13 0 L 26 7 L 26 20 L 13 13 L 0 20 L 0 7 M 4 18 L 4 5 M 9 15 L 9 2 M 13 13 V 0 M 17 15 V 2 M 22 18 V 5 M 0 20 L 3 22 L 13 17 L 21 22 L 26 20" stroke="#FFF" stroke-width="2" fill="none"/>
        </svg>
        <p>Techos</p>
      </a>
    </li>
    <li>
      <a href="/pisos">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="12" viewBox="0 0 24 12">
          <path d="m 0 12 L 24 12 L 19 0 L 5 0 L 0 12 M 8 0 L 4 12 M 11 0 L 9 12 M 13 0 L 15 12 M 16 0 L 20 12 M 6 5 L 3 5 M 7 3 V 3 H 7 H 10 M 5 9 L 9 9 M 10 6 H 14 M 17 3 H 14 M 19 9 H 15 M 21 5 H 18" stroke="#FFF" stroke-width="2"  />
        </svg>
        <p>Pisos</p>
      </a>
    </li>
  </ul>
</sidebar>

<style>
  sidebar {
    color: #fff;
    width: 15rem;
    height: 100%;
    background-color: var(--color-primario);
    margin-top: 0.5rem;
    padding: 0.5rem;
   }

  sidebar:has(#toggle-sidebar:checked){
    width: 4rem;
    transition: width 0.2s ease;
    .title-sidebar {
      justify-content: center;
    }

    .title-sidebar h3 {
      display: none;
    }
    .title-sidebar label svg {
      transform: rotate(90deg);
      
    }

    .sidebarOpcMenu {
      justify-content: center;
      a{ 
        justify-content: center;
        padding: 1rem ;
      }

      & p {
        display: none;
      }
    }
  }

  .sidebarTranslate {
    display: none;
  }

  .title-sidebar {
    display: flex;
    flex-direction: row;
    place-items: center;
    width: 100%;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-secundario);
    padding-bottom: 0.2rem;

    & h3 {
      margin: 0;
      padding: 0;
    }

    & label { 
      display: flex; 
      background: none;
      padding: 0.5rem;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    
      & svg {
        stroke: #fff;
        transform: rotate(-90deg);
      }
    }

    & label:hover {
      background-color: var(--color-secundario);
    }
  }

  .sidebarOpcMenu {
    list-style: none;
    margin: 0;
    padding: 0;

    & li  {
      margin: 0;
     
       a {
        color: #fff;
        display: flex;
        border-radius: 5px;
        place-items: center;
        gap: 0.5rem;
        padding: 0 1rem ;
        text-decoration: none;
      }
      :hover{
          background-color: var(--color-secundario);
        }    
    }
  }

  .animationSidebar {
    animation: slideLeft 0.2s ease
  }
  @keyframes slideLeft{
    0% {
      transform: translateX(-400px);
    }
    100%{
      transform: translate(0);
    }
  }
</style>

<script>
  document.addEventListener('toggleSidebar', ()=> {
    const sidebar = document.getElementById('sidebarMenu');
    sidebar?.classList.toggle('sidebarTranslate');
    sidebar?.classList.add('animationSidebar')
    
  })
</script>